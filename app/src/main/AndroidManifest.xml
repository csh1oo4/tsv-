<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Shift alarms: ring/vibrate on time, wake the screen over the lock screen. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- v2.4: the ringing alarm runs as a foreground service so its sound does not
         depend on a background Activity start being allowed. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- v2.5.4: ask to be left out of Doze so a closed app still rings on time
         (ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS in MainActivity). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- In-app update: install the freshly downloaded APK. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

        <!-- v2.4.3: the launcher entry is not MainActivity itself but one of three
             activity-aliases, one per icon. AndroidIcon (MainActivity.IconBridge)
             switches which alias is enabled, so the home-screen icon follows the choice
             in 설정 → 앱 아이콘 선택. The selected alias is enabled first and the other
             two disabled afterwards, so the launcher never sees the app with no icon. -->
        <activity-alias
            android:name=".LauncherWhite"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherBlack"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_black"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_black_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherBlue"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_blue"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_blue_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Hands the downloaded update APK (cache/updates/) to the package installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Fires at the alarm time; also re-arms the schedule after a reboot or update. -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Ringing alarm screen: shows over the lock screen and turns it on. -->
        <activity
            android:name=".AlarmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/AppTheme"
            android:turnScreenOn="true" />

        <!-- v2.4: the alarm's voice. Started by AlarmReceiver at the alarm time with a
             high-priority full-screen-intent notification; it rings (USAGE_ALARM),
             vibrates, holds a wake lock, and stops when AlarmActivity is solved or the
             auto-off timer ends. -->
        <service
            android:name=".AlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Home-screen widgets. MainActivity's AndroidWidget bridge broadcasts
             ACTION_APPWIDGET_UPDATE to each of these after every sync. -->
        <receiver
            android:name=".Widget1DayProvider"
            android:exported="true"
            android:label="@string/widget_1day_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_1day_info" />
        </receiver>

        <receiver
            android:name=".Widget2DayProvider"
            android:exported="true"
            android:label="@string/widget_2day_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_2day_info" />
        </receiver>

        <receiver
            android:name=".Widget4DayProvider"
            android:exported="true"
            android:label="@string/widget_4day_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_4day_info" />
        </receiver>

        <receiver
            android:name=".WidgetTeam4DayProvider"
            android:exported="true"
            android:label="@string/widget_team_4day_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_team_4day_info" />
        </receiver>

        <receiver
            android:name=".WidgetMonthProvider"
            android:exported="true"
            android:label="@string/widget_month_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- The month widget's < > arrows come back to this receiver. -->
                <action android:name="com.tsv.dutycalendar.action.WIDGET_MONTH_PREV" />
                <action android:name="com.tsv.dutycalendar.action.WIDGET_MONTH_NEXT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_month_info" />
        </receiver>
    </application>

</manifest>
